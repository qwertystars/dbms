# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/family_social

# Application
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Authentication (OIDC)
# Provide either AUTH_JWKS_URI (remote) or AUTH_JWKS (JSON JWKS string for local/tests).
AUTH_JWKS_URI=
AUTH_JWKS=
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=family-social-network

# Object storage (S3-compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=family-social
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
