# Local development database (libsql/SQLite file or :memory:)
# In the Cloudflare Workers runtime the D1 binding named DB is used instead.
DATABASE_URL=file:./dev.db

# Application
# The Hono API server listens on PORT (default 3000). In development the
# Vite dev server (http://localhost:5173) proxies /api to it.
APP_BASE_URL=http://localhost:3000
# Do not set NODE_ENV here. The server defaults to development, and a NODE_ENV
# in .env makes `vite build` bundle the development build of React.
PORT=3000

# Authentication
# AUTH_PROVIDER is "oidc" (default) or "clerk". For oidc, provide either
# AUTH_JWKS_URI (remote, cached and refreshed on key rotation) or AUTH_JWKS
# (a JSON JWKS string, for local use and tests). For clerk, set the two Clerk
# keys; the issuer and JWKS come from the publishable key.
AUTH_PROVIDER=oidc
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
AUTH_JWKS_URI=
AUTH_JWKS=
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=family-social-network
# Development-only cookie sign-in. Never enable this in production.
# `pnpm dev:api` sets AUTH_DEV_MODE=true for you; `pnpm start` leaves it off.
# AUTH_DEV_MODE=true
