{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "banyan",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "APP_BASE_URL": "https://banyan.srijan-guchhait.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banyan-db",
      "database_id": "9f1b3386-bd11-493f-852d-9915821e71aa",
      "migrations_dir": "db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "banyan-media",
    },
  ],
  // 100 API requests per minute per account (or per IP before sign-in),
  // counted by Cloudflare across isolates.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
}
