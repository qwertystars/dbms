{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "banyan",
  "account_id": "ee4c08f37c3a62fedc87fbd1b8b96ff4",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  // OAuth callback URLs must be registered with Google; preview URLs stay off.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "banyan.qwertystars.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "APP_BASE_URL": "https://banyan.srijan-guchhait.workers.dev",
    // Custom domains serving the same Worker; each needs its own Google callback.
    "APP_ALLOWED_ORIGINS": "https://banyan.qwertystars.dev",
    "AUTH_PROVIDER": "google",
    // Set GOOGLE_CLIENT_ID here and GOOGLE_CLIENT_SECRET with wrangler secret put.
    "GOOGLE_CLIENT_ID": "226763122782-p9pre6j56cirs2egedcots6hep4vo08u.apps.googleusercontent.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banyan-db",
      "database_id": "9f1b3386-bd11-493f-852d-9915821e71aa",
      "migrations_dir": "db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "banyan-media",
    },
  ],
  // 100 API requests per minute per account (or per IP before sign-in),
  // counted by Cloudflare across isolates.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
}
