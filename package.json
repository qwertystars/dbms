{
  "name": "family-social-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "AUTH_DEV_MODE=true tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:apply:local": "wrangler d1 migrations apply family-social-db --local",
    "db:apply:cloudflare": "wrangler d1 migrations apply family-social-db",
    "build:cloudflare": "vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:cloudflare": "vite build && wrangler deploy",
    "preview:cloudflare": "vite build && wrangler dev --var AUTH_DEV_MODE:true",
    "wrangler:types": "wrangler types"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "0.2.2",
    "@libsql/client": "^0.18.0",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.30.9",
    "drizzle-zod": "0.5.1",
    "hono": "4.4.6",
    "jose": "5.2.4",
    "nanoid": "5.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^6.30.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "20.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "4.3.0",
    "concurrently": "8.2.2",
    "drizzle-kit": "0.21.4",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "3.3.2",
    "tsx": "4.7.2",
    "typescript": "5.4.5",
    "vite": "^5.4.20",
    "vitest": "1.6.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
